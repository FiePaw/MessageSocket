<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#FAFAFA"
    tools:context=".MainActivity">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Online Users"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingBottom="4dp"/>

        <!-- Users RecyclerView with contentDescription -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUsers"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:importantForAccessibility="yes"
            android:contentDescription="@string/online_users_list_description"
            tools:ignore="SpeakableTextPresentCheck" />

        <!-- Selected User Indicator -->
        <TextView
            android:id="@+id/tvSelectedUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No user selected"
            android:padding="12dp"
            android:background="@drawable/bg_selected_indicator"
            android:layout_marginTop="8dp"
            android:textColor="#2196F3"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginVertical="8dp"/>

    <!-- Chat Messages Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Messages"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingStart="8dp"
        android:paddingBottom="4dp"/>

    <!-- Messages RecyclerView with contentDescription -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAccessibility="yes"
        android:contentDescription="@string/messages_list_description"
        tools:ignore="SpeakableTextPresentCheck" />

    <!-- Message Input Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <EditText
            android:id="@+id/edtMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type your message..."
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:background="@drawable/bg_edittext"
            android:padding="12dp"/>

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="Send"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="16dp"
            android:elevation="2dp"/>
    </LinearLayout>

</LinearLayout>